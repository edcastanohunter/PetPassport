{
  "settings": {
    "index": {
      "number_of_shards": 1,
      "number_of_replicas": 1,
      "refresh_interval": "1s"
    },
    "analysis": {
      "filter": {
        "es_stop": {
          "type": "stop",
          "stopwords": "_spanish_"
        },
        "es_stem": {
          "type": "stemmer",
          "language": "light_spanish"
        },
        "vet_synonyms": {
          "type": "synonym_graph",
          "synonyms_path": "analyzers/vet_synonyms_es.txt",
          "updateable": true
        },
        "edge": {
          "type": "edge_ngram",
          "min_gram": 2,
          "max_gram": 15
        }
      },
      "analyzer": {
        "es_text": {
          "tokenizer": "standard",
          "filter": ["lowercase", "icu_folding", "es_stop", "es_stem"]
        },
        "es_search": {
          "tokenizer": "standard",
          "filter": ["lowercase", "icu_folding", "vet_synonyms", "es_stop", "es_stem"]
        },
        "en_text": {
          "tokenizer": "standard",
          "filter": ["lowercase", "icu_folding", "stop", "porter_stem"]
        },
        "suggest": {
          "tokenizer": "standard",
          "filter": ["lowercase", "icu_folding", "edge"]
        },
        "suggest_q": {
          "tokenizer": "standard",
          "filter": ["lowercase", "icu_folding"]
        },
        "exact": {
          "tokenizer": "keyword",
          "filter": ["lowercase", "icu_folding"]
        }
      }
    }
  },
  "mappings": {
    "_meta": {
      "version": 1
    },
    "dynamic": "strict",
    "properties": {
      "doc_kind": {
        "type": "keyword"
      },
      "pet_id": {
        "type": "keyword"
      },
      "pet_name": {
        "type": "text",
        "analyzer": "es_text",
        "fields": {
          "exact": {
            "type": "text",
            "analyzer": "exact"
          }
        }
      },
      "species": {
        "type": "keyword"
      },
      "organization_id": {
        "type": "keyword"
      },
      "organization_name": {
        "type": "keyword"
      },
      "professional_id": {
        "type": "keyword"
      },
      "occurred_at": {
        "type": "date"
      },
      "encounter_type": {
        "type": "keyword"
      },
      "diagnoses": {
        "type": "nested",
        "properties": {
          "text": {
            "type": "text",
            "analyzer": "es_text",
            "search_analyzer": "es_search"
          },
          "code": {
            "type": "keyword"
          },
          "certainty": {
            "type": "keyword"
          }
        }
      },
      "text": {
        "type": "text",
        "analyzer": "es_text",
        "search_analyzer": "es_search",
        "term_vector": "with_positions_offsets"
      },
      "medications": {
        "properties": {
          "name": {
            "type": "text",
            "analyzer": "es_text"
          },
          "catalog_id": {
            "type": "keyword"
          }
        }
      },
      "procedures": {
        "type": "text",
        "analyzer": "es_text"
      },
      "vaccine_product": {
        "type": "text",
        "analyzer": "es_text"
      },
      "locale": {
        "type": "keyword"
      },
      "year": {
        "type": "short"
      },
      "access": {
        "properties": {
          "guardian_id": {
            "type": "keyword"
          },
          "org_ids_linked": {
            "type": "keyword"
          },
          "org_ids_custody": {
            "type": "keyword"
          }
        }
      },
      "position": {
        "type": "long"
      }
    }
  }
}
