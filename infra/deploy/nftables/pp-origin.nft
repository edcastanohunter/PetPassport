#!/usr/sbin/nft -f
# Filtro de origen (SEC-001, ADR-026): el 443 publicado por Podman (DNAT de
# netavark al 8443 de pp-traefik) solo acepta conexiones de Cloudflare. Los
# paquetes publicados no pasan por la cadena input del host, así que se filtra
# en forward, antes que las reglas de netavark (prioridad filter - 10).
# Plantilla: deploy.sh la rellena con los rangos de Cloudflare vigentes, la
# instala en /etc/petpassport/pp-origin.nft y la carga pp-origin-firewall.service.
table inet pp-origin
delete table inet pp-origin

table inet pp-origin {
  set cloudflare4 {
    type ipv4_addr
    flags interval
    elements = { @CF_IPV4@ }
  }

  set cloudflare6 {
    type ipv6_addr
    flags interval
    elements = { @CF_IPV6@ }
  }

  chain forward {
    type filter hook forward priority filter - 10; policy accept;
    ct status dnat ct original proto-dst 443 meta nfproto ipv4 ip saddr != @cloudflare4 counter drop
    ct status dnat ct original proto-dst 443 meta nfproto ipv6 ip6 saddr != @cloudflare6 counter drop
  }
}
