# Carga la tabla nftables pp-origin (solo Cloudflare hacia el 443 publicado).
# deploy.sh la regenera con los rangos vigentes y la recarga en cada despliegue.
[Unit]
Description=PetPassport: filtro de origen nftables (solo Cloudflare)
Wants=network-pre.target
Before=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/petpassport/pp-origin.nft
ExecReload=/usr/sbin/nft -f /etc/petpassport/pp-origin.nft
ExecStop=/usr/sbin/nft delete table inet pp-origin

[Install]
WantedBy=multi-user.target
