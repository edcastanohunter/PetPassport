# Plantilla de /etc/petpassport/staging.env (PP-F1-INF-005). El fichero real
# se genera en la VM desde el secret manager (RUNBOOK §2), con permisos 600
# y dueño root; nunca se commitea. deploy.sh se niega a usarlo con otros permisos.
#
# Convención: PP_* = configuración de la app (ARQ-011); el resto, de la
# plataforma (Keycloak, Traefik, despliegue).

# --- Dominio y versión --------------------------------------------------------
PP_DOMAIN=staging.<dominio>              # app./api./auth. bajo este dominio (DNS → WAF)
IMAGE_PREFIX=ghcr.io/edcastanohunter/petpassport

# --- Base de datos gestionada (INF-009; sslmode obligatorio) ------------------
# La API usa el rol LOGIN miembro de pp_app_writer (SEC-010): sin UPDATE/DELETE en es.events.
PP_DB_URL=postgres://petpassport_api:<secreto>@<host-pg>:5432/petpassport?sslmode=verify-full
PP_MIGRATOR_DB_URL=postgres://petpassport_migrator:<secreto>@<host-pg>:5432/petpassport?sslmode=verify-full
PP_DB_MAX_CONNS=20
# Respaldo frío semanal de es.events (DAT-009): rol de solo lectura (RUNBOOK §9.1).
PP_BACKUP_DB_URL=postgres://petpassport_backup:<secreto>@<host-pg>:5432/petpassport?sslmode=verify-full

# --- Keycloak -------------------------------------------------------------------
KC_DB_URL=jdbc:postgresql://<host-pg>:5432/keycloak?sslmode=verify-full
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=<secreto>
KC_ADMIN_USER=<admin-bootstrap>          # tras el primer arranque: crear admin nominal y borrar este
KC_ADMIN_PASSWORD=<secreto>
PP_BACKEND_CLIENT_SECRET=<secreto>       # service account petpassport-backend (IAM-011), rotación 6 meses

# --- Aplicación -------------------------------------------------------------------
PP_IP_HASH_SALT=<secreto-32+>
PP_STORAGE_ENDPOINT=<host-s3>
PP_STORAGE_BUCKET=petpassport-media-staging
PP_STORAGE_ACCESS_KEY=<secreto>
PP_STORAGE_SECRET_KEY=<secreto>
PP_BACKUP_STORAGE_ENDPOINT=<host-s3>
PP_BACKUP_STORAGE_BUCKET=petpassport-backups-staging
PP_BACKUP_STORAGE_ACCESS_KEY=<secreto>   # solo Put/Get en el bucket de respaldos
PP_BACKUP_STORAGE_SECRET_KEY=<secreto>
PP_SMTP_HOST=<smtp-transaccional>
PP_SMTP_PORT=587
PP_SMTP_USER=<usuario>
PP_SMTP_PASSWORD=<secreto>
PP_SMTP_FROM=no-reply@staging.<dominio>

# --- Borde (SEC-001) ----------------------------------------------------------------
PP_ORIGIN_AUTH_SECRET=<secreto-32+>      # = origin_auth_secret de infra/waf/cloudflare
TEAM_IP_RANGES=<ip-vpn>/32               # coma-separado; consola de Keycloak

# --- Despliegue y avisos (INF-006) --------------------------------------------------
GRAFANA_URL=http://127.0.0.1:3000
GRAFANA_ADMIN_PASSWORD=<secreto>
ALERT_SLACK_WEBHOOK_URL=<webhook-slack-alertas>   # Alertmanager; se escribe a un fichero 600
GRAFANA_TOKEN=<token-service-account-grafana>   # rol Editor, solo anotaciones
TEAM_WEBHOOK_URL=                        # opcional: webhook del canal del equipo
SMOKE_USER=smoke@staging.<dominio>       # usuario sintético pet_owner, sin OTP, onboarding hecho
SMOKE_PASSWORD=<secreto>
SMOKE_ORIGIN_IP=<ip-publica-vm>          # comprueba que el origen rechaza tráfico directo
