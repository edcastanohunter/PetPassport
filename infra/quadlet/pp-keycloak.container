# Keycloak (IAM-001, IAM-012) contra la base `keycloak` del PostgreSQL gestionado.
# Plantilla: deploy.sh sustituye @…@ e instala en /etc/containers/systemd (ADR-026).
[Unit]
Description=PetPassport: Keycloak
Wants=network-online.target
After=network-online.target

[Container]
Image=quay.io/keycloak/keycloak:26.1
ContainerName=pp-keycloak
Network=pp-edge.network
Network=pp-internal.network
Network=pp-obs.network
NetworkAlias=keycloak
Exec=start --http-port=8080 --metrics-enabled=true --health-enabled=true
# KC_DB_*, KC_HOSTNAME, KC_BOOTSTRAP_ADMIN_* (deploy.sh, desde /etc/petpassport/<env>.env).
EnvironmentFile=@STATE_DIR@/env/keycloak.env
Volume=@REPO_DIR@/infra/keycloak/themes/petpassport:/opt/keycloak/themes/petpassport:ro,z
# La imagen no trae curl; el health endpoint vive en el puerto de gestión 9000.
HealthCmd=["/bin/bash","-c","exec 3<>/dev/tcp/127.0.0.1/9000 && printf 'GET /health/ready HTTP/1.1\\r\\nHost: localhost\\r\\nConnection: close\\r\\n\\r\\n' >&3 && grep -q '\"status\": \"UP\"' <&3"]
HealthInterval=10s
HealthTimeout=5s
HealthRetries=30
HealthStartPeriod=60s
Notify=healthy
# Keycloak escribe en /opt/keycloak/data (caché de temas, tmp): rootfs escribible.
NoNewPrivileges=true
DropCapability=ALL
LogDriver=journald

[Service]
Restart=always
TimeoutStartSec=420

[Install]
WantedBy=multi-user.target
