# Traefik de origen (SEC-001, INF-005). Único contenedor con puerto publicado: 443 → 8443.
# Plantilla: deploy.sh sustituye @…@ e instala en /etc/containers/systemd (ADR-026).
# Sin dashboard; acepta solo tráfico de Cloudflare con la cabecera X-Origin-Auth
# y confía en X-Forwarded-* solo de sus rangos. El puerto publicado se filtra
# además con la tabla nftables pp-origin (RUNBOOK §1).
[Unit]
Description=PetPassport: Traefik (borde de origen)
Wants=network-online.target
After=network-online.target

[Container]
Image=docker.io/library/traefik:v3.3
ContainerName=pp-traefik
Network=pp-edge.network
Network=pp-obs.network
NetworkAlias=traefik
PublishPort=443:8443
# PP_DOMAIN, PP_ORIGIN_AUTH_SECRET y TEAM_IP_RANGES (los lee routes.yml).
EnvironmentFile=@STATE_DIR@/env/traefik.env
Volume=@REPO_DIR@/infra/traefik/staging:/etc/traefik/dynamic:ro,z
# Certificado de origen de Cloudflare (modo Full strict), fuera del repo.
Volume=@STATE_DIR@/certs:/etc/traefik/certs:ro,z
Exec=--providers.file.directory=/etc/traefik/dynamic \
  --providers.file.watch=true \
  --entrypoints.websecure.address=:8443 \
  --entrypoints.websecure.transport.respondingTimeouts.readTimeout=30s \
  --entrypoints.websecure.transport.respondingTimeouts.writeTimeout=60s \
  --entrypoints.websecure.transport.respondingTimeouts.idleTimeout=180s \
  --entrypoints.websecure.forwardedHeaders.trustedIPs=@CF_TRUSTED_IPS@ \
  --serverstransport.forwardingtimeouts.responseheadertimeout=30s \
  --entrypoints.traefik.address=:8080 \
  --metrics.prometheus=true \
  --metrics.prometheus.entryPoint=traefik \
  --ping=true \
  --ping.entryPoint=traefik \
  --api.dashboard=false \
  --log.level=INFO \
  --log.format=json \
  --accesslog=true \
  --accesslog.format=json \
  --accesslog.fields.headers.defaultmode=drop \
  --accesslog.fields.headers.names.User-Agent=keep \
  --accesslog.fields.headers.names.CF-Ray=keep
HealthCmd=["traefik","healthcheck","--ping","--ping.entryPoint=traefik","--entrypoints.traefik.address=:8080"]
HealthInterval=10s
HealthTimeout=3s
HealthRetries=6
HealthStartPeriod=5s
Notify=healthy
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL
LogDriver=journald

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
