# Blackbox exporter: readyz interno y certificados públicos (INF-007). Puertos solo en 127.0.0.1: acceso por túnel SSH (RUNBOOK §8).
# Plantilla: deploy.sh sustituye @…@ e instala en ~petpassport/.config/containers/systemd/petpassport (rootless, ADR-026).
[Unit]
Description=PetPassport: blackbox

[Container]
Image=docker.io/prom/blackbox-exporter:v0.25.0
ContainerName=pp-blackbox
Network=pp-obs.network
NetworkAlias=blackbox
Exec=--config.file=/etc/blackbox/blackbox.yml
Volume=@REPO_DIR@/infra/observability/blackbox.yml:/etc/blackbox/blackbox.yml:ro,z
NoNewPrivileges=true
DropCapability=ALL
LogDriver=journald

[Service]
Restart=always

[Install]
WantedBy=default.target
