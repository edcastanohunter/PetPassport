# Grafana: dashboards provisionados; sin acceso anónimo (INF-007). Puertos solo en 127.0.0.1: acceso por túnel SSH (RUNBOOK §8).
# Plantilla: deploy.sh sustituye @…@ e instala en ~petpassport/.config/containers/systemd/petpassport (rootless, ADR-026).
[Unit]
Description=PetPassport: grafana

[Container]
Image=docker.io/grafana/grafana:11.5.0
ContainerName=pp-grafana
Network=pp-obs.network
NetworkAlias=grafana
PublishPort=127.0.0.1:3000:3000
# GF_SECURITY_ADMIN_PASSWORD y GF_AUTH_ANONYMOUS_ENABLED=false.
EnvironmentFile=@STATE_DIR@/env/grafana.env
Volume=@REPO_DIR@/infra/observability/grafana/provisioning:/etc/grafana/provisioning:ro,z
Volume=@REPO_DIR@/infra/observability/grafana/dashboards:/var/lib/grafana/dashboards:ro,z
Volume=pp-grafanadata.volume:/var/lib/grafana
NoNewPrivileges=true
DropCapability=ALL
LogDriver=journald

[Service]
Restart=always

[Install]
WantedBy=default.target
