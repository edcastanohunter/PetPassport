# Tempo: almacén de trazas (INF-007). Puertos solo en 127.0.0.1: acceso por túnel SSH (RUNBOOK §8).
# Plantilla: deploy.sh sustituye @…@ e instala en ~petpassport/.config/containers/systemd/petpassport (rootless, ADR-026).
[Unit]
Description=PetPassport: tempo

[Container]
Image=docker.io/grafana/tempo:2.7.0
ContainerName=pp-tempo
Network=pp-obs.network
NetworkAlias=tempo
Exec=-config.file=/etc/tempo.yaml
Volume=@REPO_DIR@/infra/observability/tempo.yaml:/etc/tempo.yaml:ro,z
NoNewPrivileges=true
DropCapability=ALL
LogDriver=journald

[Service]
Restart=always

[Install]
WantedBy=default.target
