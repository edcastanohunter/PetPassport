# API (monolito Go, ARQ-011). Notify=healthy: `systemctl restart pp-api` no
# termina hasta que /readyz responde, y deploy.sh hace rollback si no llega.
# Plantilla: deploy.sh sustituye @…@ e instala en ~petpassport/.config/containers/systemd/petpassport (rootless, ADR-026).
[Unit]
Description=PetPassport: api (@PP_VERSION@)
Wants=pp-keycloak.service
After=pp-keycloak.service

[Container]
Image=@IMAGE_PREFIX@-backend:@PP_VERSION@
ContainerName=pp-api
Network=pp-edge.network
Network=pp-internal.network
Network=pp-obs.network
NetworkAlias=api
# PP_* de la aplicación (deploy.sh, desde /etc/petpassport/<env>.env).
EnvironmentFile=@STATE_DIR@/env/api.env
# Imagen distroless: el propio binario consulta /readyz (cmd/api/healthcheck.go).
HealthCmd=["/api","healthcheck"]
HealthInterval=10s
HealthTimeout=5s
HealthRetries=6
HealthStartPeriod=20s
Notify=healthy
StopTimeout=30
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL
LogDriver=journald

[Service]
Restart=always
TimeoutStartSec=180

[Install]
WantedBy=default.target
