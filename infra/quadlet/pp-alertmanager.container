# Alertmanager: enruta alertas al canal del equipo (INF-007). Puertos solo en 127.0.0.1: acceso por túnel SSH (RUNBOOK §8).
# Plantilla: deploy.sh sustituye @…@ e instala en /etc/containers/systemd (ADR-026).
[Unit]
Description=PetPassport: alertmanager

[Container]
Image=docker.io/prom/alertmanager:v0.28.0
ContainerName=pp-alertmanager
Network=pp-obs.network
NetworkAlias=alertmanager
Exec=--config.file=/etc/alertmanager/alertmanager.yml
Volume=@REPO_DIR@/infra/observability/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro,z
# Webhook de Slack (fichero 600 generado por deploy.sh, fuera del repo).
Volume=@STATE_DIR@/alert-webhook-url:/etc/alertmanager/secrets/slack_webhook_url:ro,z
NoNewPrivileges=true
DropCapability=ALL
LogDriver=journald

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
