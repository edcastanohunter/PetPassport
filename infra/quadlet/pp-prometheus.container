# Prometheus: métricas y reglas de alerta (INF-007). Puertos solo en 127.0.0.1: acceso por túnel SSH (RUNBOOK §8).
# Plantilla: deploy.sh sustituye @…@ e instala en /etc/containers/systemd (ADR-026).
[Unit]
Description=PetPassport: prometheus

[Container]
Image=docker.io/prom/prometheus:v3.2.0
ContainerName=pp-prometheus
Network=pp-obs.network
NetworkAlias=prometheus
PublishPort=127.0.0.1:9091:9090
# ${PP_ENV} en external_labels (--enable-feature=expand-external-labels).
Environment=PP_ENV=@PP_ENV@
Exec=--config.file=/etc/prometheus/prometheus.yml \
  --storage.tsdb.path=/prometheus \
  --storage.tsdb.retention.time=30d \
  --enable-feature=expand-external-labels
Volume=@REPO_DIR@/infra/observability/prometheus.yml:/etc/prometheus/prometheus.yml:ro,z
Volume=@REPO_DIR@/infra/observability/alerts.yml:/etc/prometheus/alerts.yml:ro,z
# Targets de certificados públicos (tls.json), generados por deploy.sh.
Volume=@STATE_DIR@/prom-targets:/etc/prometheus/targets:ro,z
Volume=pp-promdata.volume:/prometheus
NoNewPrivileges=true
DropCapability=ALL
LogDriver=journald

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
