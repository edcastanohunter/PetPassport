# Aplica infra/keycloak/realm.yaml de forma idempotente (PP-F1-IAM-001).
# Desarrollo rootless (ADR-026): infra/scripts/dev-quadlet.sh sustituye @REPO_DIR@
# e instala en ~/.config/containers/systemd/petpassport-dev. Credenciales solo de dev.
[Unit]
Description=PetPassport dev: keycloak-config (realm como código)
Requires=pp-dev-keycloak.service
After=pp-dev-keycloak.service

[Container]
Image=docker.io/adorsys/keycloak-config-cli:latest-26
ContainerName=pp-dev-keycloak-config
Network=pp-dev.network
Environment=KEYCLOAK_URL=http://keycloak:8080 KEYCLOAK_USER=admin KEYCLOAK_PASSWORD=admin
Environment=KEYCLOAK_AVAILABILITYCHECK_ENABLED=true KEYCLOAK_AVAILABILITYCHECK_TIMEOUT=120s
Environment=IMPORT_FILES_LOCATIONS=/config/realm.yaml IMPORT_VARSUBSTITUTION_ENABLED=true
Environment=IMPORT_MANAGED_CLIENT=full IMPORT_MANAGED_ROLE=full
Environment=PP_WEB_ORIGIN=https://app.pp.localhost PP_WEB_ORIGIN_DEV=http://localhost:5173
Environment=PP_BACKEND_CLIENT_SECRET=dev-backend-secret-change-me
Environment=PP_SMTP_HOST=mailpit PP_SMTP_PORT=1025 PP_SMTP_FROM=no-reply@petpassport.local
Environment=PP_SMTP_AUTH=false PP_SMTP_USER= PP_SMTP_PASSWORD= PP_SMTP_STARTTLS=false
Volume=@REPO_DIR@/infra/keycloak:/config:ro,z
LogDriver=journald

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=300
