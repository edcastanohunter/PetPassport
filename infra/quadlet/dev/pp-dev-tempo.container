# Tempo: almacén de trazas (INF-007). Puertos solo en 127.0.0.1.
# Desarrollo rootless (ADR-026): `make dev-obs` (infra/scripts/dev-quadlet.sh obs).
[Unit]
Description=PetPassport dev: tempo

[Container]
Image=docker.io/grafana/tempo:2.7.0
ContainerName=pp-dev-tempo
Network=pp-dev.network
NetworkAlias=tempo
Exec=-config.file=/etc/tempo.yaml
Volume=@REPO_DIR@/infra/observability/tempo.yaml:/etc/tempo.yaml:ro,z
NoNewPrivileges=true
DropCapability=ALL
LogDriver=journald

