# Buckets y políticas de MinIO (infra/minio/init.sh). Oneshot.
# Desarrollo rootless (ADR-026): infra/scripts/dev-quadlet.sh sustituye @REPO_DIR@
# e instala en ~/.config/containers/systemd/petpassport-dev. Credenciales solo de dev.
[Unit]
Description=PetPassport dev: minio-init
Requires=pp-dev-minio.service
After=pp-dev-minio.service

[Container]
# Variante con shell para init.sh.
Image=cgr.dev/chainguard/minio-client:latest-dev
ContainerName=pp-dev-minio-init
Network=pp-dev.network
Entrypoint=/bin/sh
Exec=/init.sh
Environment=MINIO_ROOT_USER=minio MINIO_ROOT_PASSWORD=minio12345
Volume=@REPO_DIR@/infra/minio/init.sh:/init.sh:ro,z
Volume=@REPO_DIR@/infra/storage:/policies:ro,z
LogDriver=journald

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=300
