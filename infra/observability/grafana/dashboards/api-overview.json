          },
          "expr": "sum(rate(pgxpool_empty_acquire_count_total[5m]))",
          "legendFormat": "esperas/s"
        }
      ],
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Runtime Go",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(go_goroutines{job=\"api\"})",
