// Grafana Alloy: logs JSON de los contenedores del proyecto → Loki (INF-007).
// La app ya emite logs sin PII (SEC-007); aquí no se transforma el contenido.
// Podman escribe los logs de los contenedores en journald (LogDriver=journald,
// ADR-026): Alloy lee el journal en solo lectura, sin socket del motor.
// Nombres: pp-<servicio> (staging/prod) o pp-dev-<servicio> (dev); el label
// service es el mismo en ambos. El resto del journal se descarta.
loki.relabel "containers" {
  forward_to = []

  rule {
    source_labels = ["__journal_container_name"]
    regex         = "pp-.+"
    action        = "keep"
  }

  rule {
    source_labels = ["__journal_container_name"]
    regex         = "pp-(?:dev-)?(.+)"
    target_label  = "service"
  }
}

loki.source.journal "containers" {
  path          = "/var/log/journal"
  relabel_rules = loki.relabel.containers.rules
  labels        = { job = "containers" }
  forward_to    = [loki.process.json.receiver]
}

loki.process "json" {
  stage.json {
    expressions = { level = "level" }
  }

  stage.labels {
    values = { level = "" }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
