# Copiar a staging.tfvars (ignorado por git) y completar. El secreto de origen
# NO va aquí: TF_VAR_origin_auth_secret desde el secret manager.
environment    = "staging"
zone_id        = "<zone-id>"
domain         = "staging.<dominio>"
origin_ip      = "<ip-publica-vm>"
team_ip_ranges = ["<ip-vpn>/32"]

# Semana 1: log. Tras revisar falsos positivos en Security Events → block.
waf_mode = "log"

